{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twis.local/schemas/digital-salvage-card.schema.json",
  "title": "Artifact Compass Digital Salvage Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "source",
    "accessBasis",
    "license",
    "primitive",
    "score",
    "verdict",
    "smallestProof",
    "handoff"
  ],
  "properties": {
    "schemaVersion": {"const": "twis-digital-salvage-v0.1"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "abandonmentSignals": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "url", "publicRead"],
      "properties": {
        "class": {
          "enum": [
            "public_git_repository",
            "software_heritage",
            "official_project_site",
            "public_package_registry",
            "academic_or_government_archive",
            "web_archive"
          ]
        },
        "url": {"type": "string", "format": "uri"},
        "publicRead": {"type": "boolean"},
        "provenanceAnchor": {"type": "string"},
        "inspectedPaths": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "accessBasis": {
      "enum": ["public_read", "public_archive", "public_domain", "owner_permission", "unknown", "reject"]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["permissive", "copyleft", "file_copyleft", "public_domain", "custom", "unknown", "reject"]
        },
        "spdxId": {"type": ["string", "null"]},
        "evidence": {"type": "string"},
        "obligations": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["take", "doNotTake"],
      "properties": {
        "take": {"type": "string", "minLength": 1},
        "doNotTake": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "runtimeFit": {
      "type": "array",
      "items": {"enum": ["browser", "local_python", "local_native", "cloudflare", "manual_handoff", "unknown"]},
      "uniqueItems": true
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "enum": [
          "unknown_license",
          "unclear_provenance",
          "plugin_execution",
          "broad_filesystem_access",
          "broad_network_access",
          "telemetry_or_upload",
          "binary_only",
          "credential_required",
          "redistribution_unclear",
          "private_or_exposed_data",
          "none"
        ]
      },
      "uniqueItems": true
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilityFit", "licenseClarity", "extractability", "runtimeFit", "evidenceQuality", "salvageValue", "total"],
      "properties": {
        "capabilityFit": {"type": "integer", "minimum": 0, "maximum": 25},
        "licenseClarity": {"type": "integer", "minimum": 0, "maximum": 20},
        "extractability": {"type": "integer", "minimum": 0, "maximum": 20},
        "runtimeFit": {"type": "integer", "minimum": 0, "maximum": 15},
        "evidenceQuality": {"type": "integer", "minimum": 0, "maximum": 10},
        "salvageValue": {"type": "integer", "minimum": 0, "maximum": 10},
        "total": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "verdict": {"enum": ["KEEP", "TEST", "WATCH", "DEFER", "REJECT", "QUARANTINE"]},
    "smallestProof": {"type": "string", "minLength": 1},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "humanApprovalRequired", "automaticActivation"],
      "properties": {
        "kind": {"enum": ["adapter", "registry_entry", "prompt_exporter", "local_script", "docs_only", "none"]},
        "targetRoom": {"type": ["string", "null"]},
        "humanApprovalRequired": {"const": true},
        "automaticActivation": {"const": false}
      }
    }
  }
}
